<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectManagerProto.Views.TaskDialogPage"
             Title="Edit Task">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Description"/>
        <Entry Text="{Binding Description}" />

        <Label Text="Due Date"/>
        <DatePicker Date="{Binding DueDate}" />

        <Label Text="Priority"/>
        <Stepper Minimum="1" Maximum="10" Value="{Binding Priority}" />

        <Label Text="Notes"/>
        <Editor Text="{Binding Notes}" HeightRequest="80"/>

        <StackLayout Orientation="Horizontal" Spacing="12">
            <Label Text="Completed"/>
            <Switch IsToggled="{Binding IsComplete}" />
        </StackLayout>

        <Label Text="{Binding DateCreated, StringFormat='Date Created: {0:yyyy-MM-dd HH:mm}'}" />

        <StackLayout Orientation="Horizontal" Spacing="24" HorizontalOptions="Center">
            <Button Text="OK" Command="{Binding OkCommand}" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>