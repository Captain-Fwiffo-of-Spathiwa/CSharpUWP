<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProjectManagerProto.Views.MainPage">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Button Text="Add Project" Clicked="OnAddProjectClicked" />
        <Button Text="Add Task To Selected Project" Clicked="OnAddTaskClicked" />

        <ListView x:Name="ProjectsList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="8" ColumnDefinitions="*,Auto,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding .}" />
                            <Label Grid.Column="1" Text="{Binding TotalTasksCount, StringFormat='Tasks: {0}'}" />
                            <Label Grid.Column="2" Text="{Binding IncompleteTasksCount, StringFormat='Incomplete: {0}'}" />
                            <Label Grid.Column="3" Text="{Binding PercentComplete, StringFormat='{0:0}%'}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>