<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ProjectManagerProto.Views.TaskDialogPage">

    <ScrollView WidthRequest="600" HeightRequest="300" BackgroundColor="Black">
        <VerticalStackLayout Padding="20" Spacing="12"  HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="White" WidthRequest="580">

            <Label Text="Description" />
            <Entry Text="{Binding Description}" />

            <Label Text="Notes" />
            <Editor Text="{Binding Notes}" HeightRequest="120" />

            <Label Text="Priority" />
            <Entry Text="{Binding PriorityValue}" Keyboard="Numeric" />

            <Label Text="Due date" />
            <DatePicker Date="{Binding DueDate}" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IsComplete}" />
                <Label Text="Complete" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding DateCreated, StringFormat='Created: {0:g}'}" />

            <Button Text="Close" Clicked="OnCloseClicked" />

        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>